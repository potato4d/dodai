{
  "name": "@potato4d/dodai",
  "version": "0.8.0",
  "description": "static website generator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "pnpm run build && pnpm run test:integration",
    "test:integration": "node --test --test-concurrency=1 tests/native-esm.test.mjs",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potato4d/dodai.git"
  },
  "keywords": [
    "static",
    "ssg",
    "build",
    "static-site-generator"
  ],
  "bin": {
    "dodai": "dist/cli.js"
  },
  "author": "potato4d (Takuma HANATANI)",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "bugs": {
    "url": "https://github.com/potato4d/dodai/issues"
  },
  "homepage": "https://github.com/potato4d/dodai#readme",
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^9.4.1",
    "consola": "^2.15.3",
    "express": "^4.18.2",
    "fs-extra": "^11.1.0",
    "get-port-please": "^3.0.1",
    "glob": "^8.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.15",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^8.0.0",
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hotreload": {
      "types": "./dist/hotreload.d.ts",
      "import": "./dist/hotreload.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
